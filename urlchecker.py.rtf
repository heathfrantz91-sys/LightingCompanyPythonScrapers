\f0\fs24 \cf0 import os\
import time\
import openpyxl\
\
from openpyxl.styles import PatternFill\
\
from selenium import webdriver\
from selenium.webdriver.common.by import By\
from selenium.webdriver.support.ui import WebDriverWait\
from selenium.webdriver.support import expected_conditions as EC\
\
from webdriver_manager.chrome import ChromeDriverManager\
from selenium.webdriver.chrome.service import Service\
\
\
# =========================\
# SETTINGS\
# =========================\
\
INPUT_FILE = "ProductsImportTemplate_deduped.xlsx"\
SHEET_NAME = "Sheet1"\
\
# Column H\
URL_COLUMN = 8\
\
# Start checking at row 2\
START_ROW = 2\
\
OUTPUT_FILE = "Checked_" + INPUT_FILE\
\
# Red fill for bad rows\
RED_FILL = PatternFill(\
    start_color="FF0000",\
    end_color="FF0000",\
    fill_type="solid"\
)\
\
\
# =========================\
# CHECK FILE\
# =========================\
\
if not os.path.exists(INPUT_FILE):\
    print(f"ERROR: Could not find \{INPUT_FILE\}")\
    raise SystemExit\
\
\
# =========================\
# LOAD EXCEL\
# =========================\
\
workbook = openpyxl.load_workbook(INPUT_FILE)\
\
if SHEET_NAME not in workbook.sheetnames:\
    print(f"ERROR: Sheet '\{SHEET_NAME\}' does not exist.")\
    print("Available sheets:")\
    for sheet in workbook.sheetnames:\
        print(f" - \{sheet\}")\
    raise SystemExit\
\
sheet = workbook[SHEET_NAME]\
\
\
# =========================\
# START CHROME\
# =========================\
\
options = webdriver.ChromeOptions()\
\
# Chrome intentionally remains visible.\
# Do not add --headless unless you want it hidden.\
\
service = Service(ChromeDriverManager().install())\
driver = webdriver.Chrome(\
    service=service,\
    options=options\
)\
\
wait = WebDriverWait(driver, 10)\
\
\
# =========================\
# COOKIE POPUP HELPER\
# =========================\
\
def accept_cookies():\
    """\
    Attempts to click common Accept / Agree cookie buttons.\
    Failure is ignored because many pages do not show one.\
    """\
\
    try:\
        buttons = driver.find_elements(\
            By.XPATH,\
            "//button[contains(translate(., "\
            "'ABCDEFGHIJKLMNOPQRSTUVWXYZ', "\
            "'abcdefghijklmnopqrstuvwxyz'), 'accept') "\
            "or contains(translate(., "\
            "'ABCDEFGHIJKLMNOPQRSTUVWXYZ', "\
            "'abcdefghijklmnopqrstuvwxyz'), 'agree')]"\
        )\
\
        for button in buttons:\
            try:\
                if button.is_displayed() and button.is_enabled():\
                    button.click()\
                    time.sleep(0.5)\
                    return\
            except Exception:\
                pass\
\
    except Exception:\
        pass\
\
\
# =========================\
# URL CHECKER\
# =========================\
\
def url_is_bad(url):\
    """\
    Opens a URL in Chrome and determines whether it appears\
    to be a dead / invalid Acuity scheduling page.\
    """\
\
    try:\
        driver.get(url)\
\
        # Wait until the page body exists\
        wait.until(\
            EC.presence_of_element_located((By.TAG_NAME, "body"))\
        )\
\
        accept_cookies()\
\
        # Give JS-rendered content a moment to appear\
        time.sleep(1)\
\
        page_source = driver.page_source.lower()\
        title = driver.title.lower()\
\
        bad_indicators = [\
            "oops! we can't seem to find the page",\
            "page not found",\
        ]\
\
        for indicator in bad_indicators:\
            if indicator in page_source:\
                return True\
\
        # Some pages signal the problem through the title\
        if "page not found" in title:\
            return True\
\
        if "404" in title:\
            return True\
\
        return False\
\
    except Exception as error:\
        print(f"    ERROR: \{error\}")\
        return True\
\
\
# =========================\
# PROCESS SPREADSHEET\
# =========================\
\
bad_count = 0\
checked_count = 0\
\
try:\
\
    total_rows = sheet.max_row - START_ROW + 1\
\
    print()\
    print(f"Checking \{total_rows\} spreadsheet rows...")\
    print()\
\
    for row_number in range(START_ROW, sheet.max_row + 1):\
\
        url = sheet.cell(\
            row=row_number,\
            column=URL_COLUMN\
        ).value\
\
        # Skip empty URL cells\
        if not url:\
            continue\
\
        url = str(url).strip()\
\
        checked_count += 1\
\
        print(\
            f"[\{checked_count\}] "\
            f"Row \{row_number\}: \{url\}"\
        )\
\
        bad = url_is_bad(url)\
\
        if bad:\
\
            print("    BAD URL")\
\
            bad_count += 1\
\
            # Highlight the entire spreadsheet row red\
            for cell in sheet[row_number]:\
                cell.fill = RED_FILL\
\
        else:\
\
            print("    OK")\
\
\
finally:\
\
    # Always close Chrome\
    driver.quit()\
\
\
# =========================\
# SAVE RESULTS\
# =========================\
\
workbook.save(OUTPUT_FILE)\
\
print()\
print("==============================")\
print("URL CHECK COMPLETE")\
print("==============================")\
print(f"URLs checked: \{checked_count\}")\
print(f"Bad URLs found: \{bad_count\}")\
print(f"Saved file: \{OUTPUT_FILE\}")\
print()}